# Email server port (React proxies /api here in dev)
PORT=3001

# SMTP — Gmail example (use App Password, not your normal password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-char-app-password

# Default From if app does not send senderEmail
SMTP_FROM=your.email@gmail.com
